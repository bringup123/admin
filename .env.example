# Customer journey V3 — environment variables. Names and explanations only, never values.

# monday API token. Aleksei's user today; every write is attributed to it. monday → Developers → My access tokens.
MONDAY_API_TOKEN=
# The CRM board.
MONDAY_BOARD_ID=1753447162

# ManyChat API token for the «BringUp» account. ManyChat → Settings → API.
MANYCHAT_API_TOKEN=

# cal.com API key on Sagi's account. cal.com → Settings → Developer → API keys. The shared one expired before 2026-10-25.
CALCOM_API_KEY=
# The needs-mapping event type.
CALCOM_EVENT_TYPE_ID=6812251
# The demo event type — does not exist yet (T-005).
CALCOM_DEMO_EVENT_TYPE_ID=

# The dafna service's kill switch (stopped 2026-10-25). From the dafna deployment's environment.
DAFNA_KILL_SWITCH_TOKEN=
