# Customer journey V3 — environment variables. Names and explanations only, never values. docs/SETUP.md says where each comes from.

APP_ENV=                     # `production` on Vercel. Anything else: only PHONE_ALLOWLIST numbers, whatever the switches say.
DATABASE_URL=                # shared Supabase, session pooler (port 5432). Tables live in schema v3 only.

MONDAY_API_TOKEN=            # monday → Developers → My access tokens. Every write is attributed to its user.
MONDAY_BOARD_ID=1753447162   # the CRM
MONDAY_WEBHOOK_SECRET=       # random; the ?token= on the monday webhook URL (monday signs nothing)

MANYCHAT_API_TOKEN=          # ManyChat → Settings → API (account-scoped)
MANYCHAT_API_BASE=https://api.manychat.com

CALCOM_WEBHOOK_SECRET=       # random; cal.com signs each delivery with it (x-cal-signature-256)
CALCOM_EVENT_TYPE_ID=6812251 # the needs-mapping event type
CALCOM_DEMO_EVENT_TYPE_ID=   # the demo event type — when it exists
BOOKING_URL=                 # the needs-mapping cal.com page, written on the card
DEMO_BOOKING_URL=            # the demo cal.com page, written on the card
CALCOM_NO_EMAIL_ADDRESS=leads@bringup.io   # the attendee address for a Lead with no email on the card
CALCOM_API_KEY=              # scripts only (webhook registration). cal.com → Settings → Developer → API keys.

KILL_SWITCH_TOKEN=           # random; /kill?token= stops everything
ADMIN_TOKEN=                 # random; /switch?token= shows and sets every switch
CRON_SECRET=                 # random; Vercel cron sends it to /internal/tick
PHONE_ALLOWLIST=             # comma-separated E.164 numbers the cage lets through
MAX_MESSAGES_PER_DAY=100     # the daily wall
TIMEZONE=Asia/Jerusalem
